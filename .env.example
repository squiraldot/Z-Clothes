# Public Blogger configuration
BLOGGER_BLOG_ID=your_blogger_blog_id
BLOGGER_API_KEY=your_google_blogger_api_key

# Dodo Payments server-only configuration
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# Optional public site URL for production
NEXT_PUBLIC_SITE_URL=https://your-domain.com
